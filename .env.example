# ─── Supermom — Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit secrets.

# ─── Supabase ──────────────────────────────────────────────────────────────────
# Find these in: Supabase Dashboard > Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://your-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — NEVER expose to the browser. Used only in tools/ scripts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection URL — used only by tools/01_setup_db.py
# Find in: Supabase Dashboard > Settings > Database > Connection string > URI
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-REF].supabase.co:5432/postgres

# ─── App ───────────────────────────────────────────────────────────────────────
# Local development:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production (change this before deploying):
# NEXT_PUBLIC_SITE_URL=https://supermom.vercel.app

# ─── Seeding (used by tools/02_seed_db.py only) ────────────────────────────────
ADMIN_EMAIL=your-admin-email@example.com

# ─── AI Chatbot (Phase 4) ──────────────────────────────────────────────────────
# Uncomment when ready to wire in the AI chatbot
# OPENAI_API_KEY=sk-...
