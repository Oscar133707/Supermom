# ─── Supermom — miljövariabler ────────────────────────────────────────────────
# Kopiera till .env.local för lokal utveckling. Lägg in samma värden i Vercel
# (Project → Settings → Environment Variables).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Endast server (push-utskick). Exponeras aldrig i webbläsaren.
SUPABASE_SERVICE_ROLE_KEY=

# Appens adress (används i länken för "Glömt lösenord")
NEXT_PUBLIC_SITE_URL=https://din-app.vercel.app

# Push-notiser – generera med:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:din-epost@example.com

# Hemlig nyckel som Supabase-cron skickar till /api/push/send (valfri lång slumpsträng)
CRON_SECRET=
